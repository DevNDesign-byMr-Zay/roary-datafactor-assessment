# Maintained service runtime
GOOGLE_CLOUD_PROJECT=assessment-project
VERTEX_LOCATION=us-central1
PORT=8080
LOG_LEVEL=info

# Historical corpus reference-only names
# These placeholders document environment-variable names that appear in preserved
# examples under "Software Engineering & AI Tooling/". The maintained service does
# not read them, and these values are intentionally non-secret/non-production.
ALLOWED_ORIGINS=http://127.0.0.1:8080
APP_API_TOKEN=example-app-token
ASTER_API_TOKEN=example-aster-token
ASTER_EXPAND_MASK_FEATHER=0
ASTER_EXPAND_PREFILL_BLUR=0
ASTER_FILL_GUIDANCE=example-guidance
ASTER_PROMPT_MAX_CHARS=4000
BUCKET_NAME=example-bucket
GEMINI_API_KEY=example-gemini-key
GOOGLE_CLOUD_REGION=us-central1

# CI/release metadata supplied automatically by GitHub Actions.
# They are documented here for complete environment discovery; local runtime does not require them.
GITHUB_SHA=
RELEASE_TAG=
