{
  "name": "conversational-ai-service-assessment",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node index.mjs",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --coverage",
    "lint": "eslint --max-warnings=0 index.mjs index.test.mjs src tests",
    "check": "npm run lint && npm run test:coverage"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.0.1",
    "@google/genai": "^2.19.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "pino": "^9.9.0",
    "zod": "^4.5.4"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "eslint": "^10.9.1",
    "jest": "^30.1.3",
    "supertest": "^7.1.4"
  }
}
