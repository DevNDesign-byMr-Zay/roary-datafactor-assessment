{
  "name": "conversational-ai-service-assessment",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node index.mjs",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --coverage",
    "lint": "eslint --max-warnings=0 --ext .mjs index.mjs index.test.mjs src tests",
    "check": "npm run lint && npm run test:coverage"
  },
  "dependencies": {
    "@google-cloud/vertexai": "^1.10.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "firebase-admin": "^13.5.0",
    "pino": "^9.9.0",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^30.1.3",
    "supertest": "^7.1.4"
  }
}
